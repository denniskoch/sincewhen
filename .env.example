# ---------------------------------------------------------------------------
# SinceWhen configuration
# Copy to `.env` and fill in. Everything here has a safe local default except
# ADMIN_PASSWORD and SESSION_SECRET, which you must set.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TZ=America/New_York
LOG_LEVEL=info

# --- Display --------------------------------------------------------------
# The heading on the wall and the browser tab title: what you are counting.
# Examples: "Time Passed Since", "Days Since We Last Broke It",
#           "Operations Incident Board"
PAGE_TITLE=Time Passed Since

# --- Database -------------------------------------------------------------
# Either "sqlite" or "postgres".
DB_CLIENT=sqlite

# Used when DB_CLIENT=sqlite. Relative paths resolve from the server package.
SQLITE_PATH=./data/sincewhen.db

# Used when DB_CLIENT=postgres. Ignored for sqlite.
DATABASE_URL=postgres://sincewhen:sincewhen@localhost:5432/sincewhen

# --- Admin auth -----------------------------------------------------------
# The single password that unlocks /admin. REQUIRED.
ADMIN_PASSWORD=change-me-before-you-deploy

# Signs the session cookie. REQUIRED, at least 32 characters.
# Run `openssl rand -base64 32` in a shell and paste the output here, keeping
# the trailing "=" — it is part of the value. This file is NOT a shell script,
# so writing $(openssl rand -base64 32) would store that text literally.
SESSION_SECRET=replace-with-openssl-rand-base64-32-output

# How long an admin session stays valid.
SESSION_TTL_HOURS=12

# --- Machine access -------------------------------------------------------
# Tokens that let external tools record incidents via POST /api/events.
# Comma-separated; "label:token" labels the caller in the audit log.
# Each token must be at least 16 characters.
#
# Run `openssl rand -hex 24` in a shell once per tool and paste the results.
# Do NOT write $(openssl rand -hex 24) here: this file is not a shell script,
# so that text would be stored verbatim as your token, and it is long enough
# that validation would accept it without complaint.
#
# Leave blank to disable machine access entirely.
# API_TOKENS=nagios:PASTE_48_HEX_CHARS_HERE,ci:PASTE_ANOTHER_48_HEX_CHARS

# Set to true only when serving over HTTPS (adds the Secure cookie flag).
COOKIE_SECURE=false

# --- Docker ---------------------------------------------------------------
# Host port that docker-compose publishes the app on.
APP_PORT=8080

# Postgres service credentials, used by docker-compose.postgres.yml.
POSTGRES_USER=sincewhen
POSTGRES_PASSWORD=sincewhen
POSTGRES_DB=sincewhen

# --- Misc -----------------------------------------------------------------
# Insert a few example counters the first time the database is created.
SEED_DEMO_DATA=true

# Comma-separated origins allowed to call the API. Leave blank in production
# where the server also serves the frontend from the same origin.
CORS_ORIGIN=http://localhost:5173
